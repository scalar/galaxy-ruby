module Scalar
  module Resources
    class Themes
      def create: (
        document: String,
        name: String,
        slug: String,
        ?description: String,
        ?request_options: Scalar::request_opts
      ) -> Scalar::UID

      def retrieve: (
        String slug,
        ?request_options: Scalar::request_opts
      ) -> String

      def update: (
        String slug,
        ?description: String,
        ?name: String,
        ?request_options: Scalar::request_opts
      ) -> top

      def list: (
        ?request_options: Scalar::request_opts
      ) -> ::Array[Scalar::Models::ThemeListResponseItem]

      def delete: (String slug, ?request_options: Scalar::request_opts) -> top

      def replace_document: (
        String slug,
        document: String,
        ?request_options: Scalar::request_opts
      ) -> top

      def initialize: (client: Scalar::Client) -> void
    end
  end
end
