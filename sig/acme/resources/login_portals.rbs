module Scalar
  module Resources
    class LoginPortals
      def create: (
        email: Scalar::LoginPortalEmail,
        page: Scalar::LoginPortalPage,
        slug: String,
        title: String,
        ?request_options: Scalar::request_opts
      ) -> Scalar::UID

      def retrieve: (
        String slug,
        ?request_options: Scalar::request_opts
      ) -> Scalar::Models::LoginPortalRetrieveResponse

      def update: (
        String slug,
        ?title: String,
        ?request_options: Scalar::request_opts
      ) -> top

      def list: (
        ?request_options: Scalar::request_opts
      ) -> ::Array[Scalar::Models::LoginPortalListResponseItem]

      def delete: (String slug, ?request_options: Scalar::request_opts) -> top

      def initialize: (client: Scalar::Client) -> void
    end
  end
end
