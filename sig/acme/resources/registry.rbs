module Scalar
  module Resources
    class Registry
      def create_api_document: (
        String namespace,
        document: String,
        slug: String,
        title: String,
        version: String,
        ?description: String,
        ?is_private: bool,
        ?ruleset: String,
        ?request_options: Scalar::request_opts
      ) -> Scalar::Models::RegistryCreateAPIDocumentResponse

      def create_api_document_access_group: (
        String slug,
        access_group_slug: String,
        namespace: String,
        ?request_options: Scalar::request_opts
      ) -> top

      def create_api_document_version: (
        String slug,
        namespace: String,
        document: String,
        version: String,
        ?force: bool,
        ?last_known_version_sha: String,
        ?request_options: Scalar::request_opts
      ) -> Scalar::ManagedDocVersion

      def delete_api_document: (
        String slug,
        namespace: String,
        ?request_options: Scalar::request_opts
      ) -> top

      def delete_api_document_access_group: (
        String slug,
        access_group_slug: String,
        namespace: String,
        ?request_options: Scalar::request_opts
      ) -> top

      def delete_api_document_version: (
        String semver,
        namespace: String,
        slug: String,
        ?request_options: Scalar::request_opts
      ) -> top

      def list_all_api_documents: (
        ?request_options: Scalar::request_opts
      ) -> ::Array[Scalar::Models::RegistryListAllAPIDocumentsResponseItem]

      def list_api_document_version_metadata: (
        String semver,
        namespace: String,
        slug: String,
        ?request_options: Scalar::request_opts
      ) -> Scalar::ManagedDocVersion

      def list_api_documents: (
        String namespace,
        ?request_options: Scalar::request_opts
      ) -> ::Array[Scalar::Models::RegistryListAPIDocumentsResponseItem]

      def retrieve_api_document_version: (
        String semver,
        namespace: String,
        slug: String,
        ?request_options: Scalar::request_opts
      ) -> String

      def update_api_document: (
        String slug,
        namespace: String,
        ?description: String,
        ?is_private: bool,
        ?ruleset: String,
        ?title: String,
        ?request_options: Scalar::request_opts
      ) -> top

      def update_api_document_version: (
        String semver,
        namespace: String,
        slug: String,
        document: String,
        ?last_known_version_sha: String,
        ?request_options: Scalar::request_opts
      ) -> Scalar::Models::RegistryUpdateAPIDocumentVersionResponse

      def initialize: (client: Scalar::Client) -> void
    end
  end
end
