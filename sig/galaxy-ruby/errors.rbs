module ScalarGalaxy
  module Errors
    class Error < StandardError
      attr_accessor cause: StandardError?
    end

    class ConversionError < ScalarGalaxy::Errors::Error
      def cause: -> StandardError?

      def initialize: (
        on: Class,
        method: Symbol,
        target: top,
        value: top,
        ?cause: StandardError?
      ) -> void
    end

    class APIError < ScalarGalaxy::Errors::Error
      attr_accessor url: URI::Generic

      attr_accessor status: Integer?

      attr_accessor headers: ::Hash[String, String]?

      attr_accessor body: top?

      def request_id: -> String?

      def problem_details: -> ::Hash[String | Symbol, top]?

      private def response_header: (String name) -> String?

      def initialize: (
        url: URI::Generic,
        ?status: Integer?,
        ?headers: ::Hash[String, String]?,
        ?body: Object?,
        ?request: nil,
        ?response: nil,
        ?message: String?
      ) -> void
    end

    class APIConnectionError < ScalarGalaxy::Errors::APIError
      def initialize: (
        url: URI::Generic,
        ?status: nil,
        ?headers: ::Hash[String, String]?,
        ?body: nil,
        ?request: nil,
        ?response: nil,
        ?message: String?
      ) -> void
    end

    class APITimeoutError < ScalarGalaxy::Errors::APIConnectionError
      def initialize: (
        url: URI::Generic,
        ?status: nil,
        ?headers: ::Hash[String, String]?,
        ?body: nil,
        ?request: nil,
        ?response: nil,
        ?message: String?
      ) -> void
    end

    class APIStatusError < ScalarGalaxy::Errors::APIError
      def self.for: (
        url: URI::Generic,
        status: Integer,
        headers: ::Hash[String, String]?,
        body: Object?,
        request: nil,
        response: nil,
        ?message: String?
      ) -> instance

      def initialize: (
        url: URI::Generic,
        status: Integer,
        headers: ::Hash[String, String]?,
        body: Object?,
        request: nil,
        response: nil,
        ?message: String?
      ) -> void
    end

    class BadRequestError < ScalarGalaxy::Errors::APIStatusError
      HTTP_STATUS: 400
    end

    class AuthenticationError < ScalarGalaxy::Errors::APIStatusError
      HTTP_STATUS: 401
    end

    class PermissionDeniedError < ScalarGalaxy::Errors::APIStatusError
      HTTP_STATUS: 403
    end

    class NotFoundError < ScalarGalaxy::Errors::APIStatusError
      HTTP_STATUS: 404
    end

    class ConflictError < ScalarGalaxy::Errors::APIStatusError
      HTTP_STATUS: 409
    end

    class UnprocessableEntityError < ScalarGalaxy::Errors::APIStatusError
      HTTP_STATUS: 422
    end

    class RateLimitError < ScalarGalaxy::Errors::APIStatusError
      HTTP_STATUS: 429
    end

    class InternalServerError < ScalarGalaxy::Errors::APIStatusError
      HTTP_STATUS: Range[Integer]
    end

    # Raised by SDKs that verify webhook signatures through the `standardwebhooks` gem when that gem
    # is not installed. This SDK verifies them with the standard library and never raises it; the
    # class is declared so code that rescues or names it keeps working.
    class MissingDependencyError < ScalarGalaxy::Errors::Error
      def initialize: (gem_name: String, feature: String) -> void
    end
  end
end
